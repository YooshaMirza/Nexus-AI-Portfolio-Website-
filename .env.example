# Server-side only. Set this in Netlify: Site settings > Environment variables.
# It is NEVER bundled into the browser code.
GEMINI_API_KEY=your-key-here
# Optional: extra allowed origins for the token endpoint, comma separated (e.g. your custom domain)
ALLOWED_ORIGINS=https://yoosha.tech
# Optional: override the Gemini Live model if Google renames it
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Local testing only: start Nexus on page load during `npm run dev`. Pair with `npm run dev:auto` so the browser allows sound.
# VITE_NEXUS_AUTOSTART=1

# Text chat model (optional). Default gemini-3.5-flash; falls back to 3.7 Flash, 2.5 Flash, 3.1 Flash-Lite when busy.
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: GitHub headline numbers in Open source (total contributions incl. private + total repos).
# Use YOUR OWN fine-grained token: All repositories, permissions Metadata + Contents = read-only.
# GITHUB_TOKEN=

# Optional: Nexus usage limits (defaults shown). Calls also end at 10 minutes.
# NEXUS_CHAT_PER_HOUR=40
# NEXUS_CHAT_DAILY=3000
# NEXUS_VOICE_PER_HOUR=8
# NEXUS_VOICE_DAILY=400

# Optional: your public site URL, for search and share tags (default https://yoosha-portfolio.netlify.app)
# SITE_URL=
